#!/bin/sh
# Side panes for cf. Usage: cf-panel sessions <chat-pane-id> | cf-panel repo <chat-pane-id> <dir>
# Redraws every few seconds and exits when the chat pane is gone. CF_ONCE=1 draws once.
mode="${1:?mode}"
chat="${2:-}"
dir="${3:-$PWD}"
root="${COPILOT_HOME:-$HOME/.copilot}/session-state"

cols=40
width() { cols=$(stty size < /dev/tty 2>/dev/null | cut -d' ' -f2); cols=${cols:-40}; }
fit() { cut -c1-"$cols"; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
yaml() { sed -n "s/^$2: *//p" "$1/workspace.yaml" 2>/dev/null | head -1; }
ago() { if [ "$1" -lt 60 ]; then echo "$1s"; elif [ "$1" -lt 3600 ]; then echo "$(($1 / 60))m"; else echo "$(($1 / 3600))h"; fi; }

sessions() {
    now=$(date +%s)
    tab=$(printf '\t')
    for lock in "$root"/*/inuse.*.lock; do
        [ -e "$lock" ] || continue
        pid=${lock##*/inuse.}
        pid=${pid%.lock}
        kill -0 "$pid" 2>/dev/null || continue
        d=${lock%/*}
        m=$(mtime "$d/events.jsonl")
        [ "$m" -gt 0 ] || m=$(mtime "$lock")
        title=$(yaml "$d" name)
        cwd=$(yaml "$d" cwd)
        case "$cwd" in "$HOME"*) cwd="~${cwd#"$HOME"}" ;; esac
        printf '%s\t%s\t%s\t%s\n' "$m" "$((now - m))" "${title:-untitled}" "${cwd:-?}"
    done | sort -rn | {
        n=0
        out=""
        while IFS=$tab read -r _ age title cwd; do
            n=$((n + 1))
            if [ "$age" -lt 8 ]; then mark="*"; else mark="-"; fi
            out="$out$mark $(printf '%-4s' "$(ago "$age")") $(printf '%s' "$title" | cut -c1-$((cols - 9)))
    $(printf '%s' "$cwd" | cut -c1-$((cols - 4)))
"
        done
        printf 'Live sessions: %s  (* working, - idle)\n\n%s' "$n" "$out"
    }
}

repo() {
    git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "not a git repo"; return; }
    git -C "$dir" status --short --branch | head -n 14
    wts=$(git -C "$dir" worktree list --porcelain | sed -n 's#^worktree .*/\.factory-worktrees/#  #p')
    [ -z "$wts" ] || printf '\nfactory worktrees:\n%s\n' "$wts"
    printf '\n'
    if [ -n "$pr_text" ]; then printf '%s\n' "$pr_text"; else echo "no PR for this branch"; fi
}

pr_text="" pr_at=0
while :; do
    if [ "$mode" = repo ] && [ $(($(date +%s) - pr_at)) -ge 60 ] && command -v gh >/dev/null 2>&1; then
        pr_at=$(date +%s)
        pr_text=$(cd "$dir" && {
            gh pr view --json number,title,state -q '"PR #\(.number) \(.state) \(.title)"' 2>/dev/null
            gh pr checks --json name,bucket -q '.[] | "  \(.bucket)  \(.name)"' 2>/dev/null
        } | head -n 12)
    fi
    width
    out=$("$mode" | fit)
    printf '\033[H%s\n\033[J' "$(printf '%s\n' "$out" | awk '{printf "%s\033[K\n", $0}')"
    [ -z "${CF_ONCE:-}" ] || break
    if [ -n "$chat" ] && ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$chat"; then break; fi
    sleep 2
done
